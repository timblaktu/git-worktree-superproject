# Example workspace.conf for testing
# Format: <git-url> <branch> [ref]
#
# Examples:
# - Default branch: https://github.com/user/repo.git main
# - Pinned to tag: https://github.com/user/repo.git main v1.0.0
# - Pinned to commit: https://github.com/user/repo.git main abc123

